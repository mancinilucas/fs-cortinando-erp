# Dependências
node_modules/

# Compilação e Build
dist/
build/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Banco de Dados Local do Prisma (SQLite / Dev DBs)
# Ignora arquivos de banco SQLite criados localmente pela URL do Prisma
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Migrações do Prisma com dados temporários (opcional/se aplicável)
# Obs: A pasta prisma/migrations DEVE ser versionada no Git.
# Apenas arquivos de dump local ou scripts temporários devem ser ignorados.

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura de Testes
coverage/
.nyc_output/

# Cache de Ferramentas e Frameworks
.nest/
.tsbuildinfo
.eslintcache

# Arquivos de Sistema e IDEs (se não colocou no .gitignore da raiz)
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/