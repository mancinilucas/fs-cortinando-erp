# PostgreSQL connection string used by Prisma and the pg driver adapter.
DATABASE_URL="postgresql://cortinas_user:cortinas_password@localhost:5432/cortinas_db"

# Runtime environment: development | test | production.
NODE_ENV=development

# HTTP port used by the NestJS backend.
PORT=3000

# Required. Origin(s) allowed to issue mutating requests (CSRF Origin validation, decisions D31 and D43).
# Comma-separated absolute origins.
APP_ORIGIN="http://localhost:5173"

# Administrative account created by the seed. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
