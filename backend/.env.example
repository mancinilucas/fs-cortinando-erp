# PostgreSQL connection string used by Prisma and the pg driver adapter.
DATABASE_URL="postgresql://cortinas_user:cortinas_password@localhost:5432/cortinas_db"

# Runtime environment: development | test | production.
NODE_ENV=development

# HTTP port used by the NestJS backend.
PORT=3000

# Origin allowed to issue mutating requests (CSRF Origin validation, decision D31).
APP_ORIGIN="http://localhost:5173"
